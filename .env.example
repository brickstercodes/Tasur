# Agent framework toggle — controls which implementation path is active.
# Values: 'mastra' (primary) | 'manual' (Vercel AI SDK fallback)
AGENT_PROVIDER=mastra

# LLM providers — at least one required depending on AGENT_PROVIDER
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase — required for all DB and storage operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
