# Agent framework toggle — controls which implementation path is active.
# Values: 'mastra' (primary) | 'manual' (Vercel AI SDK fallback)
AGENT_PROVIDER=manual

# ── Vertex AI (Gemini) ──────────────────────────────────────────────────
# LLM_PROVIDER selects which AI backend is used. Default: gemini (via Vertex AI).
LLM_PROVIDER=gemini

# Google Cloud project ID and region for Vertex AI.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Absolute path to the service account JSON key file.
# Create one at: IAM & Admin > Service Accounts > Keys > Add Key > JSON
# Required role: Vertex AI User
GOOGLE_APPLICATION_CREDENTIALS=/path/to/.secrets/vertex-sa-key.json

# Model overrides (optional — sensible defaults are built in)
# ORCHESTRATOR_MODEL=gemini-2.5-pro
# SPECIALIST_MODEL=gemini-2.5-flash
# PDF_MM_MODEL=gemini-2.5-pro

# ── Alternative LLM providers (optional) ────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Supabase — required for all DB and storage operations ───────────────
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your_32_char_secret
BETTER_AUTH_URL=http://localhost:3000

# Direct PostgreSQL connection (for BetterAuth)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web search (optional) ──────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
